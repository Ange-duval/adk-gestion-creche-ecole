<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_adk_wizard_badge_form" model="ir.ui.view">
        <field name="name">adk.wizard.badge.form</field>
        <field name="model">adk.wizard.badge</field>
        <field name="arch" type="xml">
            <form string="Générer les badges d'accès">
                <group>
                    <field name="etablissement_id"/>
                    <field name="population"/>
                    <field name="classe_ids" widget="many2many_tags"
                           invisible="population != 'eleves'"
                           domain="[('etablissement_id','=',etablissement_id)]"/>
                    <field name="format_carte"/>
                    <field name="regenerer_existants"/>
                </group>
                <footer>
                    <button name="action_generer" type="object" string="Générer"
                            class="btn-primary"/>
                    <button name="action_generer_et_imprimer" type="object"
                            string="Générer et imprimer les planches" class="btn-secondary"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_adk_wizard_badge" model="ir.actions.act_window">
        <field name="name">Assistant Badges</field>
        <field name="res_model">adk.wizard.badge</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
