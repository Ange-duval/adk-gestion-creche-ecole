<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_adk_matiere_list" model="ir.ui.view">
        <field name="name">adk.matiere.list</field>
        <field name="model">adk.matiere</field>
        <field name="arch" type="xml">
            <list string="Matières">
                <field name="code"/>
                <field name="name"/>
                <field name="coefficient"/>
                <field name="volume_horaire_annuel"/>
            </list>
        </field>
    </record>

    <record id="view_adk_matiere_form" model="ir.ui.view">
        <field name="name">adk.matiere.form</field>
        <field name="model">adk.matiere</field>
        <field name="arch" type="xml">
            <form string="Matière">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Nom de la matière"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="coefficient"/>
                            <field name="volume_horaire_annuel"/>
                            <field name="couleur" widget="color_picker"/>
                        </group>
                        <group>
                            <field name="enseignant_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Objectifs pédagogiques">
                            <field name="objectifs_pedagogiques"/>
                        </page>
                        <page string="Sessions de cours">
                            <field name="session_ids">
                                <list>
                                    <field name="classe_id"/>
                                    <field name="enseignant_id"/>
                                    <field name="heures_semaine"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_adk_matiere" model="ir.actions.act_window">
        <field name="name">Matières</field>
        <field name="res_model">adk.matiere</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
