<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===================== ANNÉE ACADÉMIQUE ===================== -->
    <record id="view_adk_annee_scolaire_list" model="ir.ui.view">
        <field name="name">adk.annee.scolaire.list</field>
        <field name="model">adk.annee.scolaire</field>
        <field name="arch" type="xml">
            <list string="Années académiques" editable="bottom">
                <field name="name"/>
                <field name="date_debut"/>
                <field name="date_fin"/>
                <field name="courante"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_adk_annee_scolaire_form" model="ir.ui.view">
        <field name="name">adk.annee.scolaire.form</field>
        <field name="model">adk.annee.scolaire</field>
        <field name="arch" type="xml">
            <form string="Année académique">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Ex : 2025-2026"/></h1>
                    </div>
                    <group>
                        <field name="date_debut"/>
                        <field name="date_fin"/>
                        <field name="courante"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_adk_annee_scolaire" model="ir.actions.act_window">
        <field name="name">Années académiques</field>
        <field name="res_model">adk.annee.scolaire</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créez une nouvelle année académique. Elle sera immédiatement disponible dans les listes
                déroulantes « Année académique » partout dans l'application, y compris pour rattraper
                des saisies concernant des années antérieures.
            </p>
        </field>
    </record>

    <!-- ===================== PÉRIODE ===================== -->
    <record id="view_adk_periode_list" model="ir.ui.view">
        <field name="name">adk.periode.list</field>
        <field name="model">adk.periode</field>
        <field name="arch" type="xml">
            <list string="Périodes" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="action_adk_periode" model="ir.actions.act_window">
        <field name="name">Périodes</field>
        <field name="res_model">adk.periode</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créez vos propres périodes d'évaluation (trimestres, semestres, sessions...).
                Elles apparaîtront aussitôt dans les listes déroulantes « Période » des notes et bulletins.
            </p>
        </field>
    </record>

    <!-- ===================== TYPE D'ÉVALUATION ===================== -->
    <record id="view_adk_type_evaluation_list" model="ir.ui.view">
        <field name="name">adk.type.evaluation.list</field>
        <field name="model">adk.type.evaluation</field>
        <field name="arch" type="xml">
            <list string="Types d'évaluation" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="action_adk_type_evaluation" model="ir.actions.act_window">
        <field name="name">Types d'évaluation</field>
        <field name="res_model">adk.type.evaluation</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créez vos propres types d'évaluation (devoir, contrôle, examen, oral...).
                Ils apparaîtront aussitôt dans la liste déroulante « Type d'évaluation » des notes.
            </p>
        </field>
    </record>

    <!-- ===================== NIVEAU ===================== -->
    <record id="view_adk_niveau_list" model="ir.ui.view">
        <field name="name">adk.niveau.list</field>
        <field name="model">adk.niveau</field>
        <field name="arch" type="xml">
            <list string="Niveaux" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="action_adk_niveau" model="ir.actions.act_window">
        <field name="name">Niveaux</field>
        <field name="res_model">adk.niveau</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créez vos propres niveaux scolaires (crèche, maternelle, primaire...).
                Ils apparaîtront aussitôt dans la liste déroulante « Niveau » des classes.
            </p>
        </field>
    </record>

</odoo>
