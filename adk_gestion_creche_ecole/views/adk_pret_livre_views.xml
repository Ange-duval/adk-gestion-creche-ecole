<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_adk_pret_livre_list" model="ir.ui.view">
        <field name="name">adk.pret.livre.list</field>
        <field name="model">adk.pret.livre</field>
        <field name="arch" type="xml">
            <list string="Prêts de livres" decoration-danger="statut in ('retard','perdu')"
                  decoration-success="statut=='retourne'">
                <field name="livre_id"/>
                <field name="eleve_id"/>
                <field name="employee_id"/>
                <field name="date_emprunt"/>
                <field name="date_retour_prevue"/>
                <field name="date_retour_effective"/>
                <field name="statut"/>
                <button name="action_marquer_retourne" type="object" string="Retourné"
                        invisible="statut in ('retourne','perdu')" class="btn-link"/>
                <button name="action_marquer_perdu" type="object" string="Perdu"
                        invisible="statut in ('retourne','perdu')" class="btn-link"/>
            </list>
        </field>
    </record>

    <record id="view_adk_pret_livre_form" model="ir.ui.view">
        <field name="name">adk.pret.livre.form</field>
        <field name="model">adk.pret.livre</field>
        <field name="arch" type="xml">
            <form string="Prêt de livre">
                <header>
                    <button name="action_marquer_retourne" type="object" string="Marquer retourné"
                            class="btn-primary" invisible="statut in ('retourne','perdu')"/>
                    <button name="action_marquer_perdu" type="object" string="Marquer perdu"
                            invisible="statut in ('retourne','perdu')"/>
                    <field name="statut" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="livre_id"/>
                            <field name="eleve_id"/>
                            <field name="employee_id"/>
                        </group>
                        <group>
                            <field name="date_emprunt"/>
                            <field name="date_retour_prevue"/>
                            <field name="date_retour_effective"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_adk_pret_livre" model="ir.actions.act_window">
        <field name="name">Prêts de livres</field>
        <field name="res_model">adk.pret.livre</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
