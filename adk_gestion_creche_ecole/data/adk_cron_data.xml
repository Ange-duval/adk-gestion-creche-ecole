<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="cron_adk_marquer_retards_livres" model="ir.cron">
            <field name="name">ADK - Marquer les prêts de livres en retard</field>
            <field name="model_id" ref="model_adk_pret_livre"/>
            <field name="state">code</field>
            <field name="code">model._cron_marquer_retards()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>

        <record id="cron_adk_suspend_expired_badges" model="ir.cron">
            <field name="name">ADK - Suspendre les badges expirés</field>
            <field name="model_id" ref="model_adk_badge"/>
            <field name="state">code</field>
            <field name="code">model._cron_suspend_expired_badges()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
